<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bubble_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 1. IDLE STATE: Sleek floating pill / mic button -->
    <LinearLayout
        android:id="@+id/layout_state_idle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_idle"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp"
        android:visibility="visible">

        <ImageView
            android:id="@+id/btn_idle_mic"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_button_primary"
            android:padding="5dp"
            android:src="@drawable/ic_mic"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Flow"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_close_idle"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:background="@color/transparent"
            android:padding="3dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <!-- 2. RECORDING STATE: Shorter & compact pill (Image 2) -->
    <LinearLayout
        android:id="@+id/layout_state_recording"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_recording"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="5dp"
        android:paddingEnd="8dp"
        android:paddingBottom="5dp"
        android:visibility="gone">

        <!-- Clickable Mic: Tapping mic also stops recording! -->
        <ImageView
            android:id="@+id/img_recording_indicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="#EF4444"
            android:padding="5dp"
            android:src="@drawable/ic_mic"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tv_recording_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Listening"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Stop Square Button -->
        <ImageView
            android:id="@+id/btn_stop_recording"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_card"
            android:padding="6dp"
            android:src="@drawable/ic_stop"
            app:tint="@color/recording_red" />

        <!-- Cancel / Dismiss Button -->
        <ImageView
            android:id="@+id/btn_cancel_recording"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="6dp"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <!-- 3. PROCESSING STATE: Indigo glowing spinner state -->
    <LinearLayout
        android:id="@+id/layout_state_processing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_processing"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="14dp"
        android:paddingBottom="7dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary_light" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Polishing..."
            android:textColor="@color/primary_light"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. PREVIEW / TONE SELECTION CARD (Matching Image 4) -->
    <LinearLayout
        android:id="@+id/layout_state_preview"
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_card"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <!-- Top Tone Selector Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Casual Tab -->
            <TextView
                android:id="@+id/tab_tone_casual"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tone_unselected"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="😊 Casual"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Semi Formal Tab -->
            <TextView
                android:id="@+id/tab_tone_semi_formal"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1.15"
                android:background="@drawable/bg_tone_selected"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="🙂 Semi-formal"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Formal Tab -->
            <TextView
                android:id="@+id/tab_tone_formal"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tone_unselected"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="👔 Formal"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Close Dialog Button -->
            <ImageView
                android:id="@+id/btn_dismiss_preview"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:padding="4dp"
                android:src="@drawable/ic_close"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Polished Text Display Area: Prominent & Scrollable -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_preview_box"
            android:minHeight="68dp"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_preview_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="Your polished English will appear here..."
                android:textColor="@color/white"
                android:textIsSelectable="true"
                android:textSize="15sp" />
        </androidx.core.widget.NestedScrollView>

        <!-- Bottom Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Language Badge / Toggle -->
            <TextView
                android:id="@+id/chip_language"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_tone_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="🌐 English"
                android:textColor="@color/primary_light"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Insert Button (with return icon ↵) -->
            <TextView
                android:id="@+id/btn_insert_text"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_insert"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Insert ↵"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
